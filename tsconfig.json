{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": [
		"src/**/*",
		"backend/**/*",
		"server/**/*",
		"*.js",
		"*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"**/*.test.ts",
		"**/*.spec.ts"
	]
}

