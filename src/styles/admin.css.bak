/* Admin dashboard styles: clean cards, responsive grid */
.admin-dashboard {
  max-width: 1200px;
  margin: 1.5rem auto; /* 24px -> 1.5rem */
  padding: 0 1rem 3rem; /* 16px 48px -> 1rem 3rem */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
  color: var(--text-color, var(--sb-text));
}

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.125rem; /* 18px -> 1.125rem */
}

.admin-stats {
  margin-bottom: 1.5rem; /* 24px -> 1.5rem */
}
.stats-cards {
  display: flex;
  gap: 1.5rem; /* 24px -> 1.5rem */
  justify-content: flex-start;
}
.stat-card {
  background: linear-gradient(90deg, var(--sb-cta-surface) 60%, rgba(233,238,240,0.8) 100%);
  border-radius: 0.75rem; /* 12px */
  box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.06); /* 2px 8px */
  padding: 1.125rem 1.75rem; /* 18px 28px */
  display: flex;
  align-items: center;
  min-width: 10rem; /* 160px */
  gap: 1rem; /* 16px -> 1rem */
}
.stat-icon {
  font-size: 2.2rem;
  color: var(--sb-accent-400);
}
.stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--sb-text);
}
.stat-label {
  font-size: 1rem;
  color: var(--sb-muted);
}

.admin-header h2 {
  margin: 0 0 4px 0;
  font-size: 1.5rem;
}
.muted { color: var(--sb-muted); margin: 0; }

.admin-actions { display: flex; gap: 0.5rem; /* 8px */ }
.admin-actions .btn, .btn { padding: 0.5rem 0.75rem; /* 8px 12px */ border-radius: 0.375rem; /* 6px */ border: 1px solid var(--sb-border); background: var(--sb-cta-surface); cursor: pointer; }
.btn-primary { background: var(--sb-accent); color: var(--sb-accent-on); border-color: var(--sb-accent); }

/* Mobile-first: stack panels by default; expand to multi-column on larger screens */
.admin-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem; /* 12px -> 0.75rem */
  align-items: start;
}

@media (min-width: 981px) {
  .admin-grid { grid-template-columns: 17.5rem 1fr 20rem; gap: 1.125rem; /* 280px 320px 18px -> rems */ }
}

.panel { background: var(--sb-surface); border-radius: 0.625rem; box-shadow: 0 0.375rem 1.125rem rgba(0,0,0,0.06); padding: 1rem; }
.panel-title { margin: 0 0 0.75rem; font-size: 1rem; color: var(--sb-text); }
.panel-side { min-height: 10rem; }
.panel-main { display: flex; flex-direction: column; gap: 0.75rem; }
.panel-section { margin-bottom: 0.75rem; }

/* Product list/table tweaks */
.panel-main .product-list table { width: 100%; border-collapse: collapse; }
.panel-main .product-list th, .panel-main .product-list td { padding: 0.5rem 0.625rem; border-bottom: 1px solid #f0f0f0; }

/* larger-screen tweaks (handled above) */
.admin-actions { margin-top: 0.75rem; }
