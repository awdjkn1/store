/* Reset and Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Import Poppins from Google Fonts (used across the app) */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap');

/* Import Collector's Green theme tokens (color-only refactor) */
@import './shenzhen-bricks-theme.css';

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Poppins', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--sb-bg);
  color: var(--sb-text);
  line-height: 1.6;
  /* Mobile-first base font size (smallest default) */
  /* moved mobile-first base down to 13px; larger breakpoints will override */
  font-size: 13px;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--sb-surface);
}

::-webkit-scrollbar-thumb {
  background: var(--sb-accent);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--sb-accent-400);
}

/* Firefox scrollbar */
html {
  scrollbar-width: thin;
  scrollbar-color: var(--sb-accent) var(--sb-surface);
}

/* Focus styles for accessibility */
button:focus,
input:focus,
select:focus,
textarea:focus,
a:focus {
  outline: 2px solid var(--sb-accent);
  outline-offset: 2px;
}

/* Remove focus outline for mouse users */
button:focus:not(:focus-visible),
input:focus:not(:focus-visible),
select:focus:not(:focus-visible),
textarea:focus:not(:focus-visible),
a:focus:not(:focus-visible) {
  outline: none;
}

/* Link styles */
a {
  color: inherit;
  text-decoration: none;
}

/* Button reset */
button {
  background: none;
  border: none;
  font: inherit;
  cursor: pointer;
}

/* Image optimization */
img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Utility classes */
.visually-hidden {
  position: absolute;
  width: 0.0625rem; /* 1px */
  height: 0.0625rem; /* 1px */
  padding: 0;
  margin: -0.0625rem; /* -1px */
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ---------------------------------------------------------------------------
  Responsive Utilities (mobile-first)
  - .container centers content on larger screens
  - .navbar is a flexible nav container that wraps on small screens
  - .product-grid provides a simple responsive product grid
  --------------------------------------------------------------------------- */

:root {
  font-size: 16px; /* base for rem calculations */
}
/* Mobile-first body sizing:
  - base (mobile default) is the smallest font-size
  - larger screens progressively increase via min-width breakpoints
*/
@media (min-width: 481px) { body { font-size: 14px; } }
/* tablet and above */
@media (min-width: 769px) { body { font-size: 16px; } }

.container {
  width: 100%;
  padding: 0 1rem;
  margin: 0 auto;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap; /* allow items to wrap on small screens */
}

/* The mobile menu toggle was removed from the header; icons are used on small screens instead. */

.product-grid {
  display: grid;
  grid-template-columns: 1fr; /* mobile: single column */
  gap: 1rem;
}

/* Hide desktop nav links by default (mobile-first). They will be shown at desktop breakpoints. */
.nav-links {
  display: none;
  width: 100%;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 0.75rem;
  align-items: center;
}

/* Keep the icon group visible and align it to the right by default */
.nav-icons {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* Header layout helpers */
.navbar-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.navbar-main-links {
  display: flex;
  align-items: center;
  gap: 3rem; /* wide spacing between main links */
}

.navbar-right-status {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.navbar-right-links {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* Contact button (bottom-left persistent) */
.contact-us-button {
  position: fixed;
  bottom: 0.75rem; /* 12px -> 0.75rem */
  left: 0.75rem;   /* 12px -> 0.75rem */
  padding: 0.625rem 0.875rem; /* 10px 14px -> 0.625rem 0.875rem */
  background-color: #3A104E; /* Deep Plum */
  color: #F7ECDE; /* Pale Mint */
  border-radius: 0.5rem; /* 8px -> 0.5rem */
  z-index: 1000;
  box-shadow: 0 0.375rem 1.125rem rgba(58,16,78,0.12); /* 6px 18px */
}

/* Admin fixed button - bottom-right */
.admin-button {
  position: fixed;
  bottom: 0;
  right: 0;
  padding: 0.625rem 0.9375rem; /* 10px 15px */
  background-color: #E0BBE4; /* Dusty Rose accent for visibility */
  color: #3A104E;            /* Deep Plum text */
  font-weight: 700;
  border: none;
  border-radius: 0.5rem 0 0 0.5rem; /* rounded top-left corner for a tab-like feel */
  z-index: 1001; /* sits above contact button */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0.5rem 1.5rem rgba(58,16,78,0.12);
  cursor: pointer;
}

/* Tooltip for admin button */
.admin-button::after {
  content: "Go to admin panel";
  position: absolute;
  bottom: calc(100% + 0.5rem); /* 8px -> 0.5rem */
  right: 50%;
  transform: translateX(50%) translateY(0.25rem); /* 4px -> 0.25rem */
  background: rgba(0,0,0,0.85);
  color: #fff;
  padding: 0.375rem 0.5rem; /* 6px 8px */
  border-radius: 0.375rem; /* 6px -> 0.375rem */
  font-size: 0.75rem; /* 12px -> 0.75rem */
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.admin-button:hover::after {
  opacity: 1;
  transform: translateX(50%) translateY(0);
}

/* Focus styles for keyboard users */
.admin-button:focus-visible,
.contact-us-button:focus-visible {
  outline: 0.1875rem solid rgba(58,16,78,0.14); /* 3px -> 0.1875rem */
  outline-offset: 0.1875rem; /* 3px -> 0.1875rem */
  box-shadow: 0 0.5rem 1.875rem rgba(58,16,78,0.12); /* 8px 30px */
}

/* Show a small label on touch/mobile devices; keep icon-only on larger screens */
.admin-button .admin-button-label {
  display: none;
}

/* Mobile-first: show label on small screens by default; desktop will hide via min-width override */
.admin-button .admin-button-label {
  display: inline-block;
  margin-left: 0.5rem; /* 8px -> 0.5rem */
  font-size: 0.95rem;
  font-weight: 700;
}
.admin-button {
  padding: 0.625rem 0.875rem; /* 10px 14px */
}

/* Hero and product description helpers */
.hero-image {
  max-width: 100%;
  height: auto;
}

.product-description-container {
  padding: 1rem;
}

/* When showing list-view for products, use a column flex layout */
.product-grid.list-view {
  display: flex !important;
  flex-direction: column;
  gap: 1rem;
  padding: 0 1rem;
}

/* Tablet breakpoint */
@media (min-width: 768px) {
  .product-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  /* On tablet and above, hide mobile labels for admin button */
  .admin-button .admin-button-label { display: none; }
}

/* Desktop breakpoint */
@media (min-width: 1024px) {
  .container {
    max-width: 1200px;
    padding: 0 2rem;
  }

  /* Show the desktop nav links on larger screens */
  .nav-links {
    display: flex;
    width: auto;
  }

  /* Slightly tighter spacing for the icon group on desktop */
  .nav-icons {
    gap: 0.75rem;
  }

  /* Optional: increase grid gap on larger screens */
  .product-grid {
    gap: 1.5rem;
  }
}

/* Mobile header adjustments */
/* Mobile-first defaults for header & nav (applies to small screens) */
.navbar-main-links {
  /* Make nav links horizontally scrollable on small screens */
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  gap: 1rem;
  font-size: 0.95rem;
  margin: 0;
}

.navbar-container {
  padding: 0.75rem 1rem;
}

/* Make sure the status block doesn't overlap content on small screens */
.navbar-right-status {
  gap: 0.5rem;
}

/* Stack the right-side links vertically on very small screens */
.navbar-right-links {
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

/* Ensure search takes full width on mobile */
.search-container {
  width: 100%;
  max-width: none;
}

.product-description-container {
  padding: 0.75rem;
}

/* Mobile: hide the desktop filters sidebar; mobile filter drawer/overlay is controlled by JS */
.mobile-filter-drawer {
  display: none;
}

/* Small, safe mobile fixes (moved from max-width:480px into mobile-first defaults)
   These rules were explicitly targeted at very small screens; keeping them as
   the default mobile styles (mobile-first). Visual check recommended.
*/
/* Make contact and admin buttons touch-friendly and non-overlapping */
.contact-us-button {
  padding: 0.75rem 0.875rem; /* 12px 14px */
  min-height: 2.75rem; /* 44px */
  min-width: 2.75rem;  /* 44px */
  left: 0.5rem; /* 8px */
  bottom: 0.5rem; /* 8px */
  border-radius: 0.625rem; /* 10px */
  font-size: 0.875rem; /* 14px */
}

.admin-button {
  padding: 0.625rem 0.75rem; /* 10px 12px */
  min-height: 2.75rem; /* 44px */
  min-width: 2.75rem;  /* 44px */
  right: 0.5rem; /* 8px */
  bottom: 0.5rem; /* 8px */
  border-radius: 0.5rem; /* 8px */
  font-size: 0.875rem; /* 14px */
}

/* Ensure nav spacing is compact on very small screens */
.navbar-main-links { gap: 0.75rem; }

/* Avoid oversized paddings that cause horizontal overflow */
.navbar-container { padding-left: 0.75rem; padding-right: 0.75rem; }

/* Desktop and tablet: show the filter drawer/sidebar by default */
@media (min-width: 768px) {
  .mobile-filter-drawer {
    display: block;
  }
}

/* Animation keyframes */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes bounce {
  0%, 20%, 53%, 80%, 100% {
    animation-timing-function: cubic-bezier(0.215, 0.610, 0.355, 1.000);
    transform: translate3d(0,0,0);
  }
  40%, 43% {
    animation-timing-function: cubic-bezier(0.755, 0.050, 0.855, 0.060);
    transform: translate3d(0, -30px, 0);
  }
  70% {
    animation-timing-function: cubic-bezier(0.755, 0.050, 0.855, 0.060);
    transform: translate3d(0, -15px, 0);
  }
  90% {
    transform: translate3d(0, -4px, 0);
  }
}

/* Animation utility classes */
.animate-fade-in {
  animation: fadeIn 0.6s ease-out;
}

.animate-slide-in-right {
  animation: slideInRight 0.6s ease-out;
}

.animate-slide-in-left {
  animation: slideInLeft 0.6s ease-out;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

.animate-bounce {
  animation: bounce 1s infinite;
}

/* Responsive font-size: tablet and desktop breakpoints already set above.
   Note: very-small adjustments were consolidated into the mobile defaults. */

/* Form styles */
input, textarea, select {
  font-family: inherit;
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="number"],
input[type="tel"],
textarea,
select {
  background-color: var(--sb-surface);
  border: 1px solid var(--sb-border);
  color: var(--sb-text);
  border-radius: 8px;
  padding: 0.75rem;
  transition: border-color 0.3s ease;
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
input[type="number"]:focus,
input[type="tel"]:focus,
textarea:focus,
select:focus {
  border-color: var(--sb-accent);
}

/* Placeholder styles */
::placeholder {
  color: var(--sb-muted);
  opacity: 1;
}

/* Custom checkbox and radio styles */
input[type="checkbox"],
input[type="radio"] {
  width: 18px;
  height: 18px;
  accent-color: var(--sb-accent);
}

/* Loading states */
.loading {
  opacity: 0.6;
  pointer-events: none;
}

/* Error states */
.error {
  border-color: var(--sb-error) !important;
}

.error-message {
  color: var(--sb-error);
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* Success states */
.success {
  border-color: var(--sb-success) !important;
}

.success-message {
  color: var(--sb-success);
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* Disabled states */
.disabled,
button:disabled,
input:disabled,
select:disabled,
textarea:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Print styles */
@media print {
  * {
    background: white !important;
    color: black !important;
  }
  
  .no-print {
    display: none !important;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  :root {
    --primary-color: #ff8c00;
    --background-color: #000000;
    --text-color: #ffffff;
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Dark mode variables */
:root {
  /* Legacy aliases mapped to theme tokens (color-only)
     This keeps older variable names working while new theme tokens
     are used across the codebase. */
  --primary-bg: var(--sb-bg);
  --secondary-bg: var(--sb-surface);
  --accent-color: var(--sb-accent);
  --accent-hover: var(--sb-accent-400);
  --text-primary: var(--sb-text);
  --text-secondary: var(--sb-muted);
  --text-muted: var(--sb-muted);
  --border-color: var(--sb-border);
  --success-color: var(--sb-success);
  --error-color: var(--sb-error);
  --warning-color: var(--sb-warning);
}

/* Component-specific styles */
.card {
  background-color: var(--secondary-bg);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
  font-size: 1rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  text-decoration: none;
}

.btn-primary {
  background-color: var(--accent-color);
  color: var(--text-primary);
}

.btn-primary:hover {
  background-color: var(--accent-hover);
  transform: translateY(-2px);
}

.btn-secondary {
  background-color: transparent;
  color: var(--accent-color);
  border: 2px solid var(--accent-color);
}

.btn-secondary:hover {
  background-color: var(--accent-color);
  color: var(--text-primary);
}

.btn-outline {
  background-color: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.btn-outline:hover {
  background-color: var(--secondary-bg);
  border-color: var(--accent-color);
  color: var(--text-primary);
}

/* Grid system */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -1rem;
}

.col {
  flex: 1;
  padding: 0 1rem;
}

.col-1 { flex: 0 0 8.333333%; }
.col-2 { flex: 0 0 16.666667%; }
.col-3 { flex: 0 0 25%; }
.col-4 { flex: 0 0 33.333333%; }
.col-5 { flex: 0 0 41.666667%; }
.col-6 { flex: 0 0 50%; }
.col-7 { flex: 0 0 58.333333%; }
.col-8 { flex: 0 0 66.666667%; }
.col-9 { flex: 0 0 75%; }
.col-10 { flex: 0 0 83.333333%; }
.col-11 { flex: 0 0 91.666667%; }
.col-12 { flex: 0 0 100%; }

/* Spacing utilities */
.m-0 { margin: 0; }
.m-1 { margin: 0.25rem; }
.m-2 { margin: 0.5rem; }
.m-3 { margin: 1rem; }
.m-4 { margin: 1.5rem; }
.m-5 { margin: 3rem; }

.p-0 { padding: 0; }
.p-1 { padding: 0.25rem; }
.p-2 { padding: 0.5rem; }
.p-3 { padding: 1rem; }
.p-4 { padding: 1.5rem; }
.p-5 { padding: 3rem; }

/* Text utilities */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-accent { color: var(--accent-color); }

.font-bold { font-weight: bold; }
.font-semibold { font-weight: 600; }
.font-normal { font-weight: normal; }

/* Display utilities */
.d-none { display: none; }
.d-block { display: block; }
.d-inline { display: inline; }
.d-inline-block { display: inline-block; }
.d-flex { display: flex; }
.d-grid { display: grid; }

/* Flex utilities */
.flex-row { flex-direction: row; }
.flex-column { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-nowrap { flex-wrap: nowrap; }

.justify-start { justify-content: flex-start; }
.justify-end { justify-content: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }

.align-start { align-items: flex-start; }
.align-end { align-items: flex-end; }
.align-center { align-items: center; }
.align-stretch { align-items: stretch; }

/* Position utilities */
.position-relative { position: relative; }
.position-absolute { position: absolute; }
.position-fixed { position: fixed; }
.position-sticky { position: sticky; }

/* Border utilities */
.border { border: 1px solid var(--border-color); }
.border-top { border-top: 1px solid var(--border-color); }
.border-bottom { border-bottom: 1px solid var(--border-color); }
.border-left { border-left: 1px solid var(--border-color); }
.border-right { border-right: 1px solid var(--border-color); }

.rounded { border-radius: 0.5rem; /* 8px */ }
.rounded-lg { border-radius: 0.75rem; /* 12px */ }
.rounded-xl { border-radius: 1rem; /* 16px */ }
.rounded-full { border-radius: 50%; }

/* Shadow utilities */
.shadow-sm { box-shadow: 0 0.0625rem 0.1875rem rgba(0, 0, 0, 0.1); /* 1px 3px */ }
.shadow { box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.15); /* 4px 12px */ }
.shadow-lg { box-shadow: 0 0.625rem 1.875rem rgba(0, 0, 0, 0.25); /* 10px 30px */ }
.shadow-xl { box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.35); /* 20px 40px */ }

/* Overflow utilities */
.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.overflow-x-auto { overflow-x: auto; }
.overflow-y-auto { overflow-y: auto; }

/* Z-index utilities */
.z-10 { z-index: 10; }
.z-20 { z-index: 20; }
.z-30 { z-index: 30; }
.z-40 { z-index: 40; }
.z-50 { z-index: 50; }