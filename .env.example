# Root .env.example for frontend
# Copy this to .env (root) to provide frontend-only env vars.

# If HoodPay publishes a browser SDK at a CDN URL, set it here so the app can dynamically load it.
# Example: REACT_APP_HOODPAY_SDK_URL=https://cdn.hoodpay.io/sdk/hoodpay.min.js
REACT_APP_HOODPAY_SDK_URL=

# API URL for the frontend to call (optional override)
REACT_APP_API_URL=http://localhost:5000/api
